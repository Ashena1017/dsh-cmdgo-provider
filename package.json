{
  "name": "dsh-cmdgo-provider",
  "version": "0.9.1-dsh017.2",
  "description": "CommandCode Go 套餐供应商：/alpha/generate CLI 网关（官方 CLI 指纹伪装）接入 DSH 模型列表 + OAuth 登录（多账号池轮询/故障转移）+ 每账号 5 小时/周/月额度显示 + 模型目录的搜索与厂家筛选（厂家别名归并，批量开关跟随筛选范围）+ 跟随宿主深浅色主题（深色下不再是白斑）+ 模型选择器左侧的订阅额度胶囊（仅选中本插件模型时显示；全部账号合计 + 实测平均单次消耗推算的理论调用次数 + 会话级缓存读/写与命中率台账）+ 视觉模型多模态（图像输入）+ 工具调用双射与请求形状自愈 —— 本地 fork，已适配 dsh 0.1.7（settings.configure + volatile 表单）与 dsh 0.2.0（宿主 API 面逐字节未变，仅放宽 peer 范围）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-protocol.mjs && node scripts/smoke-repair.mjs && node scripts/smoke-go-plan.mjs && node scripts/smoke-request-stats.mjs && node scripts/smoke-meter.mjs && node scripts/smoke-image-target.mjs && node scripts/smoke-client.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "commandcode",
    "commandcode-go",
    "cmdgo",
    "llm-provider",
    "oauth"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/cordis-plugin-loader": ">=1 <2",
    "@deepseek-ai/cosmokit": ">=1.8.0 <2",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6 <0.2.0 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.0-rc.6 <0.2.0 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.2.0 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-timeout": ">=0.1.0-rc.6 <0.2.0 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-util-values": ">=0.1.0-rc.6 <0.2.0 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ajwyunsx/dsh-cmdgo-provider.git"
  },
  "bugs": {
    "url": "https://github.com/Ajwyunsx/dsh-cmdgo-provider/issues"
  },
  "homepage": "https://github.com/Ajwyunsx/dsh-cmdgo-provider#readme",
  "publishConfig": {
    "access": "public"
  }
}
